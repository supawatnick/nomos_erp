# Development example only. Do not put production secrets in this file.

APP_ENV=development
APP_NAME=nomos-erp

POSTGRES_DB=nomos
POSTGRES_USER=nomos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nomos:change-me-local-only@localhost:5432/nomos

REDIS_URL=redis://localhost:6379/0

# Generate unique real secrets outside source control.
SESSION_SECRET=change-me
JWT_SIGNING_SECRET=change-me

# LINE Messaging API - leave empty until configured locally.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Application defaults
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_LOCALE=th
